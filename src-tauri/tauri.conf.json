{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "拓竹耗材管家",
  "version": "0.1.0",
  "identifier": "com.local.bambuspools",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "拓竹耗材管家",
        "width": 1180,
        "height": 760,
        "minWidth": 900,
        "minHeight": 640,
        "center": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "shortDescription": "离线管理拓竹耗材与本地切片任务，可选桌面黑洞效果",
    "copyright": "Copyright © 2026 Spool Keeper",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "targets": ["app", "dmg"],
    "category": "Utility",
    "macOS": { "minimumSystemVersion": "10.15" }
  }
}
